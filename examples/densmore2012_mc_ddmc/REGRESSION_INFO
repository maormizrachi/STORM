TEST_ID="densmore2012_mc_ddmc"
LEGACY_TEST_ID="desmore2012_mc_ddmc"
TAGS="mpi"
CATEGORY="physics"
# This is a runtime variant of densmore2012_mc, not a separately compiled
# physics implementation.
BUILD_TARGET="densmore2012_mc"
BINARY="{project_root}/examples/densmore2012_mc/densmore2012_mc"
MPI_NP=32
SLURM_NODES=8
SLURM_MEM_PER_CPU="10G"
SLURM_EXCLUSIVE=YES
SBATCH_ARGS='--distribution=cyclic'
RUN_COMMAND='mpirun --map-by node -np ${SLURM_NTASKS} "${STORM_BIN}"'
RUN_ARGS=["--ddmc"]
CHECK_FUNCTION="check_densmore2012_mc_ddmc_case"
TIMEOUT=5400
